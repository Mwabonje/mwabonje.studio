rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Helper Functions
    // ===============================================================
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns the user-namespaced resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is Super Administrator
    function isSuperUser() {
      return isAuthenticated() && (
        request.auth.token.email == 'ringa.michael@gmail.com' ||
        request.auth.token.email.matches('.*ringa\\.michael.*') ||
        request.auth.token.email.matches('.*admin.*')
      );
    }

    // Validate string length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional string
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidClient() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             isValidOptionalString('phone', 0, 50) &&
             isValidOptionalString('email', 0, 150) &&
             isValidOptionalString('notes', 0, 5000) &&
             isValidOptionalString('nationality', 0, 100) &&
             isValidOptionalString('leadSource', 0, 100) &&
             data.uid == request.auth.uid;
    }

    function isValidProject() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.clientId is string && data.clientId.size() > 0 && data.clientId.size() < 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             isValidOptionalString('location', 0, 500) &&
             isValidOptionalString('date', 0, 100) &&
             isValidOptionalString('description', 0, 5000) &&
             data.uid == request.auth.uid;
    }

    function isValidProjectTemplate() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             isValidOptionalString('location', 0, 500) &&
             isValidOptionalString('description', 0, 5000) &&
             data.uid == request.auth.uid;
    }

    function isValidExpense() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.date is string && data.date.size() > 0 && data.date.size() < 100 &&
             data.amount is number && data.amount > 0 &&
             data.category is string && data.category.size() > 0 && data.category.size() < 100 &&
             data.vendor is string && data.vendor.size() > 0 && data.vendor.size() < 200 &&
             isValidOptionalString('description', 0, 5000) &&
             isValidOptionalString('mpesaReference', 0, 100) &&
             data.uid == request.auth.uid;
    }

    function isValidEquipment() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             isValidOptionalString('category', 0, 100) &&
             isValidOptionalString('serialNumber', 0, 100) &&
             isValidOptionalString('purchaseDate', 0, 100) &&
             (data.purchasePrice == null || data.purchasePrice is number) &&
             isValidOptionalString('condition', 0, 100) &&
             isValidOptionalString('notes', 0, 5000) &&
             data.uid == request.auth.uid;
    }

    function isValidReminder() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.dueDate is string && data.dueDate.size() > 0 && data.dueDate.size() < 100 &&
             data.status in ['pending', 'paid', 'dismissed'] &&
             data.uid == request.auth.uid;
    }

    function isValidQuote() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.projectId is string && data.projectId.size() >= 0 && data.projectId.size() < 100 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['draft', 'sent', 'approved', 'declined'] &&
             data.uid == request.auth.uid;
    }

    function isValidInvoice() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.projectId is string && data.projectId.size() >= 0 && data.projectId.size() < 100 &&
             data.clientId is string && data.clientId.size() >= 0 && data.clientId.size() < 100 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.amountPaid is number && data.amountPaid >= 0 &&
             data.status in ['unpaid', 'partially_paid', 'paid'] &&
             data.uid == request.auth.uid;
    }

    function isValidPayment() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.invoiceId is string && data.invoiceId.size() > 0 && data.invoiceId.size() < 100 &&
             data.amount is number && data.amount > 0 &&
             data.date is string && data.date.size() > 0 && data.date.size() < 100 &&
             data.method in ['cash', 'mpesa', 'bank', 'paypal'] &&
             isValidOptionalString('reference', 0, 200) &&
             data.uid == request.auth.uid;
    }

    function isValidSettings() {
      return isValidOptionalString('logoUrl', 0, 2000) &&
             isValidOptionalString('companyName', 0, 200) &&
             isValidOptionalString('ownerName', 0, 200) &&
             isValidOptionalString('companyAddress', 0, 1000) &&
             isValidOptionalString('companyEmail', 0, 150) &&
             isValidOptionalString('companyPhone', 0, 50) &&
             isValidOptionalString('companyWebsite', 0, 200) &&
             isValidOptionalString('colorScheme', 0, 50) &&
             isValidOptionalString('documentTheme', 0, 50) &&
             isValidOptionalString('paymentDetails', 0, 2000);
    }

    function isValidFeedback() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.userId == request.auth.uid &&
             data.userEmail is string && data.userEmail.size() > 0 && data.userEmail.size() < 150 &&
             isValidOptionalString('userName', 0, 150) &&
             data.type in ['feature', 'bug', 'improvement', 'general'] &&
             isValidOptionalString('title', 0, 300) &&
             data.message is string && data.message.size() > 0 && data.message.size() < 10000 &&
             data.status in ['new', 'in_review', 'planned', 'resolved', 'dismissed'] &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() < 100 &&
             isValidOptionalString('adminNotes', 0, 5000);
    }

    // ===============================================================
    // Default Deny Catch-all
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Top-Level User-Namespaced Documents & Subcollections
    // ===============================================================

    match /users/{userId} {
      // User can read and write their own top-level profile doc
      allow get, list, create, update: if isOwner(userId);
      allow delete: if false;

      // 1. Private Expense Records (strictly filtered by UID)
      match /expenses/{expenseId} {
        allow get, list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isOwner(userId) && isValidExpense();
        allow update: if isOwner(userId) && isValidExpense() && request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 2. Private Clients (strictly filtered by UID)
      match /clients/{clientId} {
        allow get, list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isOwner(userId) && isValidClient();
        allow update: if isOwner(userId) && isValidClient() && request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 3. Private Projects (strictly filtered by UID)
      match /projects/{projectId} {
        allow get, list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isOwner(userId) && isValidProject();
        allow update: if isOwner(userId) && isValidProject() && request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 4. Private Project Templates
      match /project_templates/{templateId} {
        allow get, list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isOwner(userId) && isValidProjectTemplate();
        allow update: if isOwner(userId) && isValidProjectTemplate() && request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 5. Private Equipment Assets
      match /equipment/{equipmentId} {
        allow get, list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isOwner(userId) && isValidEquipment();
        allow update: if isOwner(userId) && isValidEquipment() && request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 6. Private Reminders
      match /reminders/{reminderId} {
        allow get, list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isOwner(userId) && isValidReminder();
        allow update: if isOwner(userId) && isValidReminder() && request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 7. Private Payments
      match /payments/{paymentId} {
        allow get, list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isOwner(userId) && isValidPayment();
        allow update: if isOwner(userId) && isValidPayment() && request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 8. Quotes (public get for shared link, authenticated list/write for owner)
      match /quotes/{quoteId} {
        allow get: if true;
        allow list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isOwner(userId) && isValidQuote();
        allow update: if isOwner(userId) && isValidQuote() && request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 9. Invoices (public get for shared link, authenticated list/write for owner)
      match /invoices/{invoiceId} {
        allow get: if true;
        allow list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isOwner(userId) && isValidInvoice();
        allow update: if isOwner(userId) && isValidInvoice() && request.resource.data.uid == resource.data.uid;
        allow delete: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 10. Settings (public get for brand rendering on shared links, write for owner)
      match /settings/{settingId} {
        allow get: if true;
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSettings();
        allow update: if isOwner(userId) && isValidSettings();
        allow delete: if isOwner(userId);
      }
    }

    // ===============================================================
    // Top-Level Collections Protection (Strict UID Filter)
    // ===============================================================

    match /expenses/{expenseId} {
      allow get, list, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && isValidExpense();
      allow update: if isAuthenticated() && isValidExpense() && request.resource.data.uid == resource.data.uid;
    }

    match /clients/{clientId} {
      allow get, list, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && isValidClient();
      allow update: if isAuthenticated() && isValidClient() && request.resource.data.uid == resource.data.uid;
    }

    match /projects/{projectId} {
      allow get, list, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && isValidProject();
      allow update: if isAuthenticated() && isValidProject() && request.resource.data.uid == resource.data.uid;
    }

    // ===============================================================
    // Feedbacks Collection
    // ===============================================================
    match /feedbacks/{feedbackId} {
      // Super user sees all feedback; regular users can only read their own submitted feedback
      allow get, list: if isAuthenticated() && (isSuperUser() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidFeedback();
      allow update, delete: if isSuperUser();
    }
  }
}
