rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Helper Functions
    // ===============================================================

    // Require signed-in user with a verified email
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Check if user owns the user-namespaced resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Strictly restrict Super Administrator privileges to the verified owner email
    function isSuperUser() {
      return isAuthenticated() && request.auth.token.email == 'ringa.michael@gmail.com';
    }

    // Validate document ID format to prevent oversized/malformed path injection
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validate optional string
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUserRoot() {
      let data = request.resource.data;
      return data.keys().hasOnly(['email', 'lastLogin']) &&
             isValidOptionalString('email', 0, 150) &&
             isValidOptionalString('lastLogin', 0, 100);
    }

    function isValidClient() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             isValidOptionalString('phone', 0, 50) &&
             isValidOptionalString('email', 0, 150) &&
             isValidOptionalString('notes', 0, 5000) &&
             isValidOptionalString('nationality', 0, 100) &&
             isValidOptionalString('leadSource', 0, 100) &&
             data.uid == request.auth.uid;
    }

    function isValidProject() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.clientId is string && data.clientId.size() > 0 && data.clientId.size() < 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             isValidOptionalString('location', 0, 500) &&
             isValidOptionalString('date', 0, 100) &&
             isValidOptionalString('description', 0, 5000) &&
             data.uid == request.auth.uid;
    }

    function isValidProjectTemplate() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             isValidOptionalString('location', 0, 500) &&
             isValidOptionalString('description', 0, 5000) &&
             data.uid == request.auth.uid;
    }

    function isValidExpense() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.date is string && data.date.size() > 0 && data.date.size() < 100 &&
             data.amount is number && data.amount > 0 &&
             data.category is string && data.category.size() > 0 && data.category.size() < 100 &&
             data.vendor is string && data.vendor.size() > 0 && data.vendor.size() < 200 &&
             isValidOptionalString('description', 0, 5000) &&
             isValidOptionalString('mpesaReference', 0, 100) &&
             data.uid == request.auth.uid;
    }

    function isValidEquipment() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             isValidOptionalString('category', 0, 100) &&
             isValidOptionalString('serialNumber', 0, 100) &&
             isValidOptionalString('purchaseDate', 0, 100) &&
             (data.purchasePrice == null || data.purchasePrice is number) &&
             isValidOptionalString('condition', 0, 100) &&
             isValidOptionalString('notes', 0, 5000) &&
             data.uid == request.auth.uid;
    }

    function isValidReminder() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.dueDate is string && data.dueDate.size() > 0 && data.dueDate.size() < 100 &&
             data.status in ['pending', 'paid', 'dismissed'] &&
             data.uid == request.auth.uid;
    }

    function isValidQuote() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.projectId is string && data.projectId.size() >= 0 && data.projectId.size() < 100 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['draft', 'sent', 'approved', 'declined'] &&
             data.uid == request.auth.uid;
    }

    function isValidInvoice() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.projectId is string && data.projectId.size() >= 0 && data.projectId.size() < 100 &&
             data.clientId is string && data.clientId.size() >= 0 && data.clientId.size() < 100 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.amountPaid is number && data.amountPaid >= 0 &&
             data.status in ['unpaid', 'partially_paid', 'paid'] &&
             data.uid == request.auth.uid;
    }

    function isValidPayment() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.invoiceId is string && data.invoiceId.size() > 0 && data.invoiceId.size() < 100 &&
             data.amount is number && data.amount > 0 &&
             data.date is string && data.date.size() > 0 && data.date.size() < 100 &&
             data.method in ['cash', 'mpesa', 'bank', 'paypal'] &&
             isValidOptionalString('reference', 0, 200) &&
             data.uid == request.auth.uid;
    }

    function isValidSettings() {
      return isValidOptionalString('logoUrl', 0, 2000) &&
             isValidOptionalString('companyName', 0, 200) &&
             isValidOptionalString('ownerName', 0, 200) &&
             isValidOptionalString('companyAddress', 0, 1000) &&
             isValidOptionalString('companyEmail', 0, 150) &&
             isValidOptionalString('companyPhone', 0, 50) &&
             isValidOptionalString('companyWebsite', 0, 200) &&
             isValidOptionalString('colorScheme', 0, 50) &&
             isValidOptionalString('documentTheme', 0, 50) &&
             isValidOptionalString('paymentDetails', 0, 2000);
    }

    function isValidSchoolDeposit() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.date is string && data.date.size() > 0 && data.date.size() < 100 &&
             data.amount is number && data.amount > 0 &&
             data.paymentMethod in ['mpesa', 'bank_transfer', 'standing_order', 'cash', 'cheque', 'other'] &&
             data.targetTerm is string && data.targetTerm.size() > 0 && data.targetTerm.size() < 150 &&
             data.purpose in ['tuition', 'admission', 'uniform_books', 'transport_meals', 'general_savings', 'other'] &&
             isValidOptionalString('mpesaReference', 0, 150) &&
             isValidOptionalString('notes', 0, 5000) &&
             data.uid == request.auth.uid;
    }

    function isValidFeedbackFields() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() < 128 &&
             data.userEmail is string && data.userEmail.size() > 0 && data.userEmail.size() < 150 &&
             isValidOptionalString('userName', 0, 150) &&
             data.type in ['feature', 'bug', 'improvement', 'general'] &&
             isValidOptionalString('title', 0, 300) &&
             data.message is string && data.message.size() > 0 && data.message.size() < 10000 &&
             data.status in ['new', 'in_review', 'planned', 'resolved', 'dismissed'] &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() < 100 &&
             (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 5)) &&
             isValidOptionalString('adminNotes', 0, 5000);
    }

    function isValidSystemUser() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 150 &&
             isValidOptionalString('displayName', 0, 150) &&
             data.role in ['super_admin', 'studio_admin', 'photographer', 'viewer'] &&
             data.status in ['active', 'suspended'] &&
             data.joinedAt is string && data.joinedAt.size() > 0 && data.joinedAt.size() < 100 &&
             isValidOptionalString('lastActiveAt', 0, 100) &&
             isValidOptionalString('phone', 0, 50) &&
             isValidOptionalString('notes', 0, 5000);
    }

    function isValidAuditLog() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() < 100 &&
             data.actorId is string && data.actorId.size() > 0 && data.actorId.size() < 100 &&
             data.actorEmail is string && data.actorEmail.size() > 0 && data.actorEmail.size() < 150 &&
             isValidOptionalString('actorName', 0, 150) &&
             data.category in ['auth', 'finance', 'project', 'settings', 'security'] &&
             data.action is string && data.action.size() > 0 && data.action.size() < 100 &&
             data.description is string && data.description.size() > 0 && data.description.size() < 2000 &&
             data.severity in ['info', 'warning', 'critical'] &&
             isValidOptionalString('targetResourceId', 0, 100) &&
             isValidOptionalString('targetResourceType', 0, 100);
    }

    function isValidSystemAnnouncement() {
      let data = request.resource.data;
      return data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.message is string && data.message.size() > 0 && data.message.size() < 5000 &&
             data.type in ['info', 'warning', 'announcement'] &&
             data.isActive is bool &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() < 100 &&
             data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() < 150 &&
             isValidOptionalString('expiresAt', 0, 100);
    }

    // ===============================================================
    // Default Deny Catch-all
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Top-Level User-Namespaced Documents & Subcollections
    // ===============================================================

    match /users/{userId} {
      // User can read and write their own top-level login metadata; Super Admin can list/get for active user tracking
      allow get: if isValidId(userId) && (isOwner(userId) || isSuperUser());
      allow list: if isSuperUser();
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidUserRoot();
      allow delete: if false;

      // 1. Private Expense Records (strictly filtered by UID)
      match /expenses/{expenseId} {
        allow get: if isValidId(expenseId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isValidId(expenseId) && isOwner(userId) && isValidExpense();
        allow update: if isValidId(expenseId) && isOwner(userId) && isValidExpense() && request.resource.data.uid == resource.data.uid;
        allow delete: if isValidId(expenseId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 2. Private Clients (strictly filtered by UID)
      match /clients/{clientId} {
        allow get: if isValidId(clientId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isValidId(clientId) && isOwner(userId) && isValidClient();
        allow update: if isValidId(clientId) && isOwner(userId) && isValidClient() && request.resource.data.uid == resource.data.uid;
        allow delete: if isValidId(clientId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 3. Private Projects (strictly filtered by UID)
      match /projects/{projectId} {
        allow get: if isValidId(projectId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isValidId(projectId) && isOwner(userId) && isValidProject();
        allow update: if isValidId(projectId) && isOwner(userId) && isValidProject() && request.resource.data.uid == resource.data.uid;
        allow delete: if isValidId(projectId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 4. Private Project Templates
      match /project_templates/{templateId} {
        allow get: if isValidId(templateId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isValidId(templateId) && isOwner(userId) && isValidProjectTemplate();
        allow update: if isValidId(templateId) && isOwner(userId) && isValidProjectTemplate() && request.resource.data.uid == resource.data.uid;
        allow delete: if isValidId(templateId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 5. Private Equipment Assets
      match /equipment/{equipmentId} {
        allow get: if isValidId(equipmentId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isValidId(equipmentId) && isOwner(userId) && isValidEquipment();
        allow update: if isValidId(equipmentId) && isOwner(userId) && isValidEquipment() && request.resource.data.uid == resource.data.uid;
        allow delete: if isValidId(equipmentId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 6. Private Reminders
      match /reminders/{reminderId} {
        allow get: if isValidId(reminderId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isValidId(reminderId) && isOwner(userId) && isValidReminder();
        allow update: if isValidId(reminderId) && isOwner(userId) && isValidReminder() && request.resource.data.uid == resource.data.uid;
        allow delete: if isValidId(reminderId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 7. Private Payments
      match /payments/{paymentId} {
        allow get: if isValidId(paymentId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isValidId(paymentId) && isOwner(userId) && isValidPayment();
        allow update: if isValidId(paymentId) && isOwner(userId) && isValidPayment() && request.resource.data.uid == resource.data.uid;
        allow delete: if isValidId(paymentId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 8. Quotes (public get by exact ID for client shared link, authenticated list/write for owner)
      match /quotes/{quoteId} {
        allow get: if isValidId(quoteId);
        allow list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isValidId(quoteId) && isOwner(userId) && isValidQuote();
        allow update: if isValidId(quoteId) && isOwner(userId) && isValidQuote() && request.resource.data.uid == resource.data.uid;
        allow delete: if isValidId(quoteId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 9. Invoices (public get by exact ID for client shared link, authenticated list/write for owner)
      match /invoices/{invoiceId} {
        allow get: if isValidId(invoiceId);
        allow list: if isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
        allow create: if isValidId(invoiceId) && isOwner(userId) && isValidInvoice();
        allow update: if isValidId(invoiceId) && isOwner(userId) && isValidInvoice() && request.resource.data.uid == resource.data.uid;
        allow delete: if isValidId(invoiceId) && isOwner(userId) && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
      }

      // 10. Settings (public get for brand rendering on shared links, write for owner)
      match /settings/{settingId} {
        allow get: if isValidId(settingId);
        allow list: if isOwner(userId);
        allow create, update: if isValidId(settingId) && isOwner(userId) && isValidSettings();
        allow delete: if isValidId(settingId) && isOwner(userId);
      }

      // 11. Son's School Deposits & Account Meta (Strictly Super Admin only)
      match /school_deposits/{depositId} {
        allow get: if isValidId(depositId) && isOwner(userId) && isSuperUser();
        allow list: if isOwner(userId) && isSuperUser();
        allow create: if isValidId(depositId) && isOwner(userId) && isSuperUser() && isValidSchoolDeposit();
        allow update: if isValidId(depositId) && isOwner(userId) && isSuperUser() && isValidSchoolDeposit() && request.resource.data.uid == resource.data.uid;
        allow delete: if isValidId(depositId) && isOwner(userId) && isSuperUser();
      }

      match /school_deposits_meta/{metaId} {
        allow get: if isValidId(metaId) && isOwner(userId) && isSuperUser();
        allow list: if isOwner(userId) && isSuperUser();
        allow create, update, delete: if isValidId(metaId) && isOwner(userId) && isSuperUser();
      }
    }

    // ===============================================================
    // Top-Level Collections Protection (Strict UID Filter)
    // ===============================================================

    match /expenses/{expenseId} {
      allow get, delete: if isValidId(expenseId) && isAuthenticated() && resource.data.uid == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(expenseId) && isAuthenticated() && isValidExpense();
      allow update: if isValidId(expenseId) && isAuthenticated() && isValidExpense() && request.resource.data.uid == resource.data.uid;
    }

    match /clients/{clientId} {
      allow get, delete: if isValidId(clientId) && isAuthenticated() && resource.data.uid == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(clientId) && isAuthenticated() && isValidClient();
      allow update: if isValidId(clientId) && isAuthenticated() && isValidClient() && request.resource.data.uid == resource.data.uid;
    }

    match /projects/{projectId} {
      allow get, delete: if isValidId(projectId) && isAuthenticated() && resource.data.uid == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(projectId) && isAuthenticated() && isValidProject();
      allow update: if isValidId(projectId) && isAuthenticated() && isValidProject() && request.resource.data.uid == resource.data.uid;
    }

    // ===============================================================
    // Feedbacks Collection
    // ===============================================================
    match /feedbacks/{feedbackId} {
      // Super Admin sees all feedback; regular users can only read their own submitted feedback
      allow get: if isValidId(feedbackId) && isAuthenticated() && (isSuperUser() || resource.data.userId == request.auth.uid);
      allow list: if isAuthenticated() && (isSuperUser() || resource.data.userId == request.auth.uid);
      allow create: if isValidId(feedbackId) &&
                       isAuthenticated() &&
                       isValidFeedbackFields() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.userEmail == request.auth.token.email &&
                       request.resource.data.status == 'new' &&
                       !('adminNotes' in request.resource.data);
      allow update: if isValidId(feedbackId) &&
                       isSuperUser() &&
                       isValidFeedbackFields() &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isValidId(feedbackId) && isSuperUser();
    }

    // ===============================================================
    // Super Admin: System User Directory (Zero Self-Escalation)
    // ===============================================================
    match /system_users/{userId} {
      allow get: if isValidId(userId) && (isSuperUser() || (isAuthenticated() && request.auth.uid == userId));
      allow list: if isSuperUser();
      allow create: if isValidId(userId) &&
                       isValidSystemUser() &&
                       request.resource.data.id == userId && (
                         isSuperUser() || (
                           isAuthenticated() &&
                           request.auth.uid == userId &&
                           request.resource.data.email == request.auth.token.email &&
                           request.resource.data.role == 'photographer' &&
                           request.resource.data.status == 'active'
                         )
                       );
      allow update: if isValidId(userId) &&
                       isValidSystemUser() && (
                         isSuperUser() || (
                           isAuthenticated() &&
                           request.auth.uid == userId &&
                           resource.data.status == 'active' &&
                           request.resource.data.id == resource.data.id &&
                           request.resource.data.email == resource.data.email &&
                           request.resource.data.joinedAt == resource.data.joinedAt &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'displayName'])
                         )
                       );
      allow delete: if isValidId(userId) && isSuperUser();
    }

    // ===============================================================
    // Super Admin: Security Audit Log (Immutable append, no actor spoofing)
    // ===============================================================
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isSuperUser();
      allow list: if isSuperUser();
      allow create: if isValidId(logId) &&
                       isAuthenticated() &&
                       isValidAuditLog() &&
                       request.resource.data.actorId == request.auth.uid &&
                       request.resource.data.actorEmail == request.auth.token.email;
      allow update, delete: if false; // strictly immutable audit trail
    }

    // ===============================================================
    // Global System Announcements
    // ===============================================================
    match /system_announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isValidId(announcementId) && isSuperUser() && isValidSystemAnnouncement();
      allow update: if isValidId(announcementId) &&
                       isSuperUser() &&
                       isValidSystemAnnouncement() &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isValidId(announcementId) && isSuperUser();
    }
  }
}
