{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "Private client belonging to an authenticated photographer account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "notes": { "type": "string" },
        "nationality": { "type": "string" },
        "leadSource": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["id", "name", "uid"]
    },
    "Project": {
      "title": "Project",
      "description": "Private photography project belonging to an authenticated user account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "collaborators": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "splitType": { "type": "string", "enum": ["equal", "percentage", "fixed", "transport"] },
              "percentage": { "type": "number" },
              "amount": { "type": "number" }
            }
          }
        },
        "uid": { "type": "string" }
      },
      "required": ["id", "clientId", "title", "uid"]
    },
    "ProjectTemplate": {
      "title": "ProjectTemplate",
      "description": "Custom reusable project template belonging to an individual user account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "collaborators": { "type": "array" },
        "uid": { "type": "string" }
      },
      "required": ["id", "name", "title", "uid"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Private expense record logged by an individual user account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "vendor": { "type": "string" },
        "description": { "type": "string" },
        "mpesaReference": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["id", "date", "amount", "category", "vendor", "uid"]
    },
    "Equipment": {
      "title": "Equipment",
      "description": "Private equipment asset belonging to an individual user account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "serialNumber": { "type": "string" },
        "purchaseDate": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "condition": { "type": "string" },
        "notes": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["id", "name", "uid"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Private scheduled reminder belonging to an individual user account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dueDate": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "isRecurring": { "type": "boolean" },
        "recurringInterval": { "type": "string", "enum": ["monthly", "yearly"] },
        "status": { "type": "string", "enum": ["pending", "paid", "dismissed"] },
        "uid": { "type": "string" }
      },
      "required": ["id", "title", "dueDate", "status", "uid"]
    },
    "Quote": {
      "title": "Quote",
      "description": "A quote for a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quoteNumber": { "type": "string" },
        "projectId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "clientPhone": { "type": "string" },
        "projectTitle": { "type": "string" },
        "issueDate": { "type": "string" },
        "eventDate": { "type": "string" },
        "moodboardLink": { "type": "string" },
        "packages": { "type": "array" },
        "note": { "type": "string" },
        "retainerClause": { "type": "string" },
        "fulfillmentSchedule": { "type": "string" },
        "usageLicense": { "type": "string" },
        "usageRights": { "type": "string" },
        "transportLogistics": { "type": "string" },
        "cancellationRescheduling": { "type": "string" },
        "paymentDetails": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "sent", "approved", "declined"] },
        "date": { "type": "string" },
        "selectedPackages": { "type": "array" },
        "revisionOf": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["id", "projectId", "totalAmount", "status", "uid"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "An invoice for a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quoteId": { "type": "string" },
        "projectId": { "type": "string" },
        "clientId": { "type": "string" },
        "lineItems": { "type": "array" },
        "totalAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "status": { "type": "string", "enum": ["unpaid", "partially_paid", "paid"] },
        "date": { "type": "string" },
        "dueDate": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["id", "projectId", "clientId", "totalAmount", "amountPaid", "status", "uid"]
    },
    "Payment": {
      "title": "Payment",
      "description": "A payment for an invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "method": { "type": "string", "enum": ["cash", "mpesa", "bank", "paypal"] },
        "reference": { "type": "string" },
        "uid": { "type": "string" }
      },
      "required": ["id", "invoiceId", "amount", "date", "method", "uid"]
    },
    "Settings": {
      "title": "Settings",
      "description": "User settings",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "companyName": { "type": "string" },
        "ownerName": { "type": "string" },
        "companyAddress": { "type": "string" },
        "companyEmail": { "type": "string" },
        "companyPhone": { "type": "string" },
        "companyWebsite": { "type": "string" },
        "colorScheme": { "type": "string" },
        "documentTheme": { "type": "string" },
        "paymentDetails": { "type": "string" }
      }
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback, bug report, or feature suggestion",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["feature", "bug", "improvement", "general"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "in_review", "planned", "resolved", "dismissed"] },
        "createdAt": { "type": "string" },
        "rating": { "type": "number" },
        "adminNotes": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "type", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Private client records filtered by user account UID"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Private projects filtered by user account UID"
    },
    "/users/{userId}/project_templates/{templateId}": {
      "schema": { "$ref": "#/entities/ProjectTemplate" },
      "description": "Private reusable project templates filtered by user account UID"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Private expense records filtered by user account UID"
    },
    "/users/{userId}/equipment/{equipmentId}": {
      "schema": { "$ref": "#/entities/Equipment" },
      "description": "Private equipment records filtered by user account UID"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/Reminder" },
      "description": "Private reminders filtered by user account UID"
    },
    "/users/{userId}/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/Quote" },
      "description": "Quotes belonging to a user (viewable publicly by clients via share link)"
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Invoices belonging to a user (viewable publicly by clients via share link)"
    },
    "/users/{userId}/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Payments belonging to a user"
    },
    "/users/{userId}/settings/profile": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Settings for a user"
    },
    "/feedbacks/{feedbackId}": {
      "schema": { "$ref": "#/entities/Feedback" },
      "description": "User system feedback and feature suggestions for super user"
    }
  }
}
